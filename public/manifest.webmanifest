{
  "name": "Chop Deck",
  "short_name": "Chop Deck",
  "description": "A sampler and sequencer in the shape of a classic drum machine. Chop breaks, play pads, make beats. In your browser.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#1B1B1B",
  "theme_color": "#1F3F6E",
  "categories": ["music", "entertainment"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [{ "src": "/og.png", "sizes": "1200x630", "type": "image/png", "form_factor": "wide" }],
  "file_handlers": [
    { "action": "/", "accept": { "audio/wav": [".wav"], "audio/midi": [".mid"], "application/octet-stream": [".chopdeck", ".all", ".aps", ".pgm", ".snd"] } }
  ]
}
