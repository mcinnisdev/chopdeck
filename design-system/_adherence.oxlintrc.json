{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/display/**",
              "ui_kits/chopdeck-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow Condensed|Barlow|VT323))/i]",
        "message": "Font not provided by the design system. Available: Barlow Condensed, Barlow, VT323."
      },
      {
        "selector": "JSXOpeningElement[name.name='CursorPad'] > JSXAttribute > JSXIdentifier[name!=/^(?:onMove|label|onDark|style|key|ref|className|style|children)$/]",
        "message": "<CursorPad> doesn't accept that prop. Declared props: onMove, label, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fader'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|min|max|onChange|height|onDark|style|key|ref|className|style|children)$/]",
        "message": "<Fader> doesn't accept that prop. Declared props: label, value, min, max, onChange, height, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HardButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|cap|size|led|ledOn|active|disabled|labelPosition|onDark|onClick|style|key|ref|className|style|children)$/]",
        "message": "<HardButton> doesn't accept that prop. Declared props: label, children, cap, size, led, ledOn, active, disabled, labelPosition, onDark, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HardButton'] > JSXAttribute[name.name='cap'] > Literal[value!=/^(?:key|red|amber|dark|navy)$/]",
        "message": "<HardButton> cap must be one of 'key' | 'red' | 'amber' | 'dark' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HardButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<HardButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HardButton'] > JSXAttribute[name.name='led'] > Literal[value!=/^(?:red|green|amber)$/]",
        "message": "<HardButton> led must be one of 'red' | 'green' | 'amber'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HardButton'] > JSXAttribute[name.name='labelPosition'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<HardButton> labelPosition must be one of 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Knob'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|min|max|onChange|size|ticks|onDark|style|key|ref|className|style|children)$/]",
        "message": "<Knob> doesn't accept that prop. Declared props: label, value, min, max, onChange, size, ticks, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Knob'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Knob> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lcd'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|title|cols|rows|fontSize|style|key|ref|className|style|children)$/]",
        "message": "<Lcd> doesn't accept that prop. Declared props: children, title, cols, rows, fontSize, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LcdWindow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|keys|onKey|style|key|ref|className|style|children)$/]",
        "message": "<LcdWindow> doesn't accept that prop. Declared props: title, children, keys, onKey, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Led'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|on|size|label|style|key|ref|className|style|children)$/]",
        "message": "<Led> doesn't accept that prop. Declared props: color, on, size, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Led'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:red|green|amber)$/]",
        "message": "<Led> color must be one of 'red' | 'green' | 'amber'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pad'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|note|color|lit|size|onTrigger|style|key|ref|className|style|children)$/]",
        "message": "<Pad> doesn't accept that prop. Declared props: label, note, color, lit, size, onTrigger, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pad'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:red|grey)$/]",
        "message": "<Pad> color must be one of 'red' | 'grey'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|recessed|onDark|padding|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, children, recessed, onDark, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Waveform'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|chops|selected|playhead|height|width|style|key|ref|className|style|children)$/]",
        "message": "<Waveform> doesn't accept that prop. Declared props: data, chops, selected, playhead, height, width, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
