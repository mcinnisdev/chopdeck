{
  "name": "chopdeck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chop Deck: a browser sampler/sequencer in the shape of a late-90s drum machine",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "ci": "npm run typecheck && npm test && npm run test:e2e && npm run build",
    "assets": "node scripts/og/make.mjs",
    "dev:api": "wrangler pages dev --port 8788",
    "db:local": "wrangler d1 execute chopdeck --local --file=server/schema.sql",
    "db:remote": "wrangler d1 execute chopdeck --remote --file=server/schema.sql"
  },
  "dependencies": {
    "better-auth": "^1.7.3",
    "hono": "^4.13.7",
    "kysely": "^0.29.5",
    "kysely-d1": "^0.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "miniflare": "^4.20260730.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.129.0"
  }
}
